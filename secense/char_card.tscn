[sub_resource type="Shader" id="Shader_ykj4p"]
code = "shader_type canvas_item;

uniform float speed = 1.5;

vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void fragment() {
    // پیدا کردن مرکز
    vec2 center = vec2(0.5, 0.5);
    vec2 uv = UV - center;
    
    // چرخش رنگ‌ها
    float angle = atan(uv.y, uv.x) / (2.0 * 3.14159);
    float hue = fract(angle + TIME * speed);
    
    // گرفتن شکل و میزان گردی گوشه‌ها از StyleBox گودوت
    float current_alpha = COLOR.a;
    
    // رنگ‌آمیزی قاب با حفظ شکل و آلفای اصلی
    COLOR = vec4(hsv2rgb(vec3(hue, 1.0, 1.0)), current_alpha);
}  "

