; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="نیروی شهر"
run/main_scene="uid://e4n07u2xh3f5"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="uid://kk8m63jkxch8"

[autoload]

Global="*uid://da37v50gy1e74"
Network="*uid://bkdsesnu7o527"
LocalSettings="*res://scripts/LocalSettings.gd"
MusicManager="*uid://d1no57v4j7hyt"
CombatFX="*res://scripts/combat_fx.gd"
Billing="*res://scripts/Billing.gd"
Ads="*res://scripts/Ads.gd"
LoadingScreen="*res://scripts/loading_screen.gd"
Tutorial="*res://scripts/tutorial.gd"
SafeArea="*res://scripts/safe_area.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[dotnet]

project/assembly_name="Gun_Game"

[editor_plugins]

enabled=PackedStringArray("res://addons/rewarded_ads/plugin.cfg", "res://addons/iap_billing/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[plugins]

ai_assistant_hub/options/debug_mode=0
ai_assistant_hub/llm_api="ollama_api"
ai_assistant_hub/preferences/thinking_target=0
ai_assistant_hub/preferences/skip_greeting=false
ai_assistant_hub/preferences/always_scroll_to_bottom=false
ai_assistant_hub/preferences/audio_hints=true
ai_assistant_hub/options/debug_http_content=false

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
